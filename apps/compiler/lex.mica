// Mica lexer, written in Mica.
//
// Stage one of the self-hosting path (#80): a lexer over the scalar string
// scanning surface (`text[i]`, `len(text)`, `string_slice`). Token kinds and
// their spelling mirror the Odin lexer in `mica/compiler/lexer.odin` so the two
// can be compared token for token over the corpus.
//
// The lexer is byte-free: it indexes scalar positions, so multi-byte UTF-8 is
// handled by the runtime and never appears here. It produces significant
// tokens only; whitespace and `//` comments are skipped and runs of newlines
// collapse to one `:Newline`. Punctuation that can extend a name (`#`, `?`,
// `@`, `:`, `/`, `.`) is emitted as its own token and assembled by the parser,
// matching the Odin lexer.
//
// Token shape: a map per token with `:kind` (symbol), `:text` (string, empty
// for punctuation/newline), `:offset` (scalar position of the first character),
// `:line`, and `:column`. `:offset` is a scalar position, not a byte offset.
//
// Character classification is inlined in the scan loops. A verb call per
// scalar is the whole cost of a lexer; keeping the inner loops to integer
// comparisons makes the difference between roughly linear and quadratic
// behavior in interpreter overhead. The keyword spelling table is a map built
// once per `lex` call, not a comparison chain per identifier.

make_identity(:lexer)

verb lex(source) -> list
  // A keyword spelling table built for this run of the lexer. A chain of 31
  // string comparisons per identifier costs several times a single
  // canonicalized map probe; building the table is about two microseconds, so
  // it is not worth any longer-lived home.
  let keywords = {
    "let" -> :Let, "const" -> :Const, "if" -> :If, "elseif" -> :Elseif,
    "else" -> :Else, "end" -> :End, "begin" -> :Begin, "for" -> :For,
    "in" -> :In, "while" -> :While, "return" -> :Return, "raise" -> :Raise,
    "recover" -> :Recover, "spawn" -> :Spawn, "after" -> :After,
    "not" -> :Not, "break" -> :Break, "continue" -> :Continue, "try" -> :Try,
    "catch" -> :Catch, "as" -> :As, "finally" -> :Finally, "fn" -> :Fn,
    "method" -> :Method, "verb" -> :Verb, "do" -> :Do, "assert" -> :Assert,
    "retract" -> :Retract, "require" -> :Require, "true" -> :True,
    "false" -> :False,
  }

  let tokens = []
  let pos = 0
  let line = 1
  let column = 1
  let length = len(source)

  while pos < length
    let start = pos
    let start_line = line
    let start_column = column
    let code = source[pos]

    // Space or tab.
    if code == 32 || code == 9
      pos = pos + 1
      column = column + 1
      continue
    end

    // A run of line breaks collapses to one `:Newline` token. `\r\n` counts
    // as one break, as does a lone `\r` or `\n`.
    if code == 10 || code == 13
      while pos < length && (source[pos] == 10 || source[pos] == 13)
        if source[pos] == 13 && pos + 1 < length && source[pos + 1] == 10
          pos = pos + 2
        else
          pos = pos + 1
        end
        line = line + 1
        column = 1
      end
      tokens = [@tokens, {:kind -> :Newline, :text -> string_slice(source, start, pos), :offset -> start, :line -> start_line, :column -> start_column}]
      continue
    end

    // `//` line comment: skipped, not tokenized.
    if code == 47 && pos + 1 < length && source[pos + 1] == 47
      while pos < length && source[pos] != 10 && source[pos] != 13
        pos = pos + 1
        column = column + 1
      end
      continue
    end

    // String literal. A backslash escapes the next scalar; the literal may
    // span lines, tracking them, and an unterminated one becomes `:Error`.
    if code == 34
      pos = pos + 1
      column = column + 1
      let terminated = false
      while pos < length
        if source[pos] == 92
          pos = pos + 1
          column = column + 1
          if pos < length
            if source[pos] == 10 || source[pos] == 13
              line = line + 1
              column = 1
            else
              column = column + 1
            end
            pos = pos + 1
          end
          continue
        end
        if source[pos] == 34
          pos = pos + 1
          column = column + 1
          terminated = true
          break
        end
        if source[pos] == 10 || source[pos] == 13
          line = line + 1
          column = 1
        else
          column = column + 1
        end
        pos = pos + 1
      end
      let kind = :Error
      if terminated
        kind = :String
      end
      tokens = [@tokens, {:kind -> kind, :text -> string_slice(source, start, pos), :offset -> start, :line -> start_line, :column -> start_column}]
      continue
    end

    // Byte-string literal: `b"..."`. No escapes, matching the Odin lexer.
    if code == 98 && pos + 1 < length && source[pos + 1] == 34
      pos = pos + 2
      column = column + 2
      let terminated = false
      while pos < length
        if source[pos] == 34
          pos = pos + 1
          column = column + 1
          terminated = true
          break
        end
        pos = pos + 1
        column = column + 1
      end
      let kind = :Error
      if terminated
        kind = :Bytes
      end
      tokens = [@tokens, {:kind -> kind, :text -> string_slice(source, start, pos), :offset -> start, :line -> start_line, :column -> start_column}]
      continue
    end

    // Number: digits, an optional fractional part, and an optional exponent.
    if code >= 48 && code <= 57
      let is_float = false
      while pos < length && source[pos] >= 48 && source[pos] <= 57
        pos = pos + 1
        column = column + 1
      end
      if pos + 1 < length && source[pos] == 46 && source[pos + 1] != 46 && source[pos + 1] >= 48 && source[pos + 1] <= 57
        pos = pos + 1
        column = column + 1
        while pos < length && source[pos] >= 48 && source[pos] <= 57
          pos = pos + 1
          column = column + 1
        end
        is_float = true
      end
      if pos < length && (source[pos] == 101 || source[pos] == 69)
        let next = pos + 1
        if next < length && (source[next] == 43 || source[next] == 45)
          next = next + 1
        end
        if next < length && source[next] >= 48 && source[next] <= 57
          while pos < next
            pos = pos + 1
            column = column + 1
          end
          while pos < length && source[pos] >= 48 && source[pos] <= 57
            pos = pos + 1
            column = column + 1
          end
          is_float = true
        end
      end
      let kind = :Int
      if is_float
        kind = :Float
      end
      tokens = [@tokens, {:kind -> kind, :text -> string_slice(source, start, pos), :offset -> start, :line -> start_line, :column -> start_column}]
      continue
    end

    // Identifier, keyword, or `E_` error-code spelling. ASCII letters, digits,
    // and underscore only, matching the Odin lexer.
    if (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
      let scanning = true
      while scanning && pos < length
        let c = source[pos]
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
          pos = pos + 1
          column = column + 1
        else
          scanning = false
        end
      end
      let text = string_slice(source, start, pos)
      let kind = :Ident
      if pos - start > 2 && text[0] == 69 && text[1] == 95
        kind = :Error_Code
      else
        kind = index_or(keywords, text, :Ident)
      end
      tokens = [@tokens, {:kind -> kind, :text -> text, :offset -> start, :line -> start_line, :column -> start_column}]
      continue
    end

    // A lone underscore is the wildcard; `_x` is an identifier.
    if code == 95
      pos = pos + 1
      column = column + 1
      let kind = :Underscore
      let scanning = true
      while scanning && pos < length
        let c = source[pos]
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
          pos = pos + 1
          column = column + 1
        else
          scanning = false
        end
      end
      if pos - start > 1
        kind = :Ident
      end
      tokens = [@tokens, {:kind -> kind, :text -> string_slice(source, start, pos), :offset -> start, :line -> start_line, :column -> start_column}]
      continue
    end

    // Punctuation, longest match first. `kind` and `width` are set by the
    // matching branch; the default is an `:Error` token of one scalar.
    let next = 0
    if pos + 1 < length
      next = source[pos + 1]
    end
    let kind = :Error
    let width = 1

    // Two-scalar forms.
    if code == 46 && next == 46
      kind = :DotDot
      width = 2
    elseif code == 58 && next == 45
      kind = :Colon_Dash
      width = 2
    elseif code == 61 && next == 61
      kind = :Eq_Eq
      width = 2
    elseif code == 61 && next == 62
      kind = :Fat_Arrow
      width = 2
    elseif code == 33 && next == 61
      kind = :Bang_Eq
      width = 2
    elseif code == 60 && next == 61
      kind = :Lt_Eq
      width = 2
    elseif code == 62 && next == 61
      kind = :Gt_Eq
      width = 2
    elseif code == 38 && next == 38
      kind = :Amp_Amp
      width = 2
    elseif code == 124 && next == 124
      kind = :Pipe_Pipe
      width = 2
    elseif code == 45 && next == 62
      kind = :Arrow
      width = 2
    // One-scalar forms.
    elseif code == 40
      kind = :LParen
    elseif code == 41
      kind = :RParen
    elseif code == 91
      kind = :LBracket
    elseif code == 93
      kind = :RBracket
    elseif code == 123
      kind = :LBrace
    elseif code == 125
      kind = :RBrace
    elseif code == 44
      kind = :Comma
    elseif code == 59
      kind = :Semi
    elseif code == 35
      kind = :Hash
    elseif code == 64
      kind = :At
    elseif code == 63
      kind = :Question
    elseif code == 46
      kind = :Dot
    elseif code == 58
      kind = :Colon
    elseif code == 61
      kind = :Eq
    elseif code == 33
      kind = :Bang
    elseif code == 60
      kind = :Lt
    elseif code == 62
      kind = :Gt
    elseif code == 38
      kind = :Error
    elseif code == 124
      kind = :Pipe
    elseif code == 45
      kind = :Minus
    elseif code == 43
      kind = :Plus
    elseif code == 42
      kind = :Star
    elseif code == 47
      kind = :Slash
    elseif code == 37
      kind = :Percent
    elseif code == 8712
      // U+2208, the membership operator.
      kind = :Membership
    end

    pos = pos + width
    column = column + width
    tokens = [@tokens, {:kind -> kind, :text -> string_slice(source, start, pos), :offset -> start, :line -> start_line, :column -> start_column}]
  end

  tokens = [@tokens, {:kind -> :Eof, :text -> "", :offset -> length, :line -> line, :column -> column}]
  return tokens
end
