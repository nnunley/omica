// Minimal streaming LLM chat demo.
//
// It sends one Chat Completions request, logs the text deltas as they arrive,
// and records the assembled answer as a `llm/DemoResult` fact so hosts and
// tests can observe it.
//
// Against OpenRouter:
//
//   OPENROUTER_API_KEY=... odin run tools/filein -- apps/examples/llm-chat.mica
//
// Against any OpenAI-compatible server (llama.cpp, vLLM, Ollama):
//
//   MICA_OPENAI_BASE_URL=http://127.0.0.1:8000/v1 \
//     odin run tools/filein -- apps/examples/llm-chat.mica
//
// Environment:
//   MICA_OPENAI_BASE_URL   API base URL; defaults to OpenRouter.
//   MICA_LLM_DEMO_MODEL    Model name; defaults to deepseek/deepseek-v4-pro.
//   MICA_LLM_DEMO_PROMPT   Prompt; defaults to a short greeting request.

make_identity(:llm/demo)
make_relation(:llm/DemoResult, 2)

// Flattens a batch message and returns the text it carries.
verb llm/demo_text(message)
  if index_or(message, :type, none) == :batch
    let text = ""
    for event in index_or(message, :events, [])
      text = string_concat(text, llm/demo_text(event))
    end
    return text
  end
  if index_or(message, :type, none) == :text_delta
    return index_or(message, :delta, "")
  end
  return ""
end

verb llm/demo_model()
  let configured = os_getenv("MICA_LLM_DEMO_MODEL")
  if let some(model) = configured
    return model
  end
  return "deepseek/deepseek-v4-pro"
end

verb llm/demo_prompt()
  let configured = os_getenv("MICA_LLM_DEMO_PROMPT")
  if let some(prompt) = configured
    return prompt
  end
  return "Say hello in one short sentence."
end

verb llm/demo_run(prompt @ #string)
  let [receiver, sender] = mailbox()
  llm_chat_stream_to(
    llm/demo_model(),
    [{:role -> "user", :content -> prompt}],
    {:stream -> true},
    [],
    sender
  )

  let text = ""
  let failed = false
  let done = false
  while done == false
    let ready = mailbox_recv([receiver], 500)
    if ready == []
      // No events for half a second: the stream is over or stalled.
      done = true
    else
      for group in ready
        for message in group[1]
          if index_or(message, :type, none) == :error
            log(string_concat("llm error: ", index_or(message, :message, "unknown")))
            failed = true
            done = true
          else
            text = string_concat(text, llm/demo_text(message))
          end
        end
      end
    end
  end
  mailbox_close(receiver)
  assert llm/DemoResult(prompt, text)
  if failed
    return none
  end
  log(text)
  return text
end

llm/demo_run(llm/demo_prompt())
