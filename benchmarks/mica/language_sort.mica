// Shared benchmark grant preamble (see the other corpus files).
make_identity(:bench)
make_relation(:CanInvoke, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
grant #bench
  invoke:
    :bench
    :setup
  read:
    :Point
    :Label
    :Entry
    :Edge
    :Reach
  write:
    :Point
    :Label
    :Entry
    :Edge
end
// Sorting a list of integers.
//
// Per-call workload: sort a 512-element list that is generated in descending
// order, so the sort does real work. Exercises the builtin in the C/bytecode
// boundary rather than the interpreter loop.
verb bench()
  let items = []
  let index = 512
  while index > 0
    items = [@items, index]
    index = index - 1
  end
  return len(sort(items))
end
