// List indexing over a loop.
//
// Per-call workload: 100k indexed reads of an 8-element list.
verb bench()
  let items = [1, 2, 3, 4, 5, 6, 7, 8]
  let slot = 0
  let index = 0
  let total = 0
  while index < 100000
    total = total + items[slot]
    slot = slot + 1
    if slot == 8
      slot = 0
    end
    index = index + 1
  end
  return total
end
