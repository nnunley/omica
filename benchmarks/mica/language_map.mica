// Map lookup over a loop.
//
// Per-call workload: 100k lookups across a 4-entry symbol map.
verb bench()
  let table = {:a -> 1, :b -> 2, :c -> 3, :d -> 4}
  let index = 0
  let total = 0
  while index < 100000
    total = total + table[:a]
    total = total + table[:b]
    index = index + 1
  end
  return total
end
