// Sequential relation scan.
//
// Setup seeds 1000 rows; per-call workload scans them all and counts.
make_relation(:Point, 1)

verb setup()
  let index = 0
  while index < 1000
    assert Point(index)
    index = index + 1
  end
end

verb bench()
  let count = 0
  for row in Point(?x)
    count = count + 1
  end
  return count
end
